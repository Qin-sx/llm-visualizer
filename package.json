		"autoprefixer": "^10.4.16",
		"postcss": "^8.4.33",
		"svelte": "^5.53.5",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^3.4.1",
		"typescript": "^5.0.0",
		"vite": "^7.0.0"
	},
	"dependencies": {
		"gsap": "^3.12.5",
		"katex": "^0.16.10"
	}
